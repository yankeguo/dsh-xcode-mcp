{
  "name": "@yankeguo/dsh-xcode-mcp",
  "version": "0.1.0",
  "description": "Mount the Xcode MCP server into DeepSeek Harness sessions whose working directory is inside an Xcode project.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yankeguo/dsh-xcode-mcp.git"
  },
  "homepage": "https://github.com/yankeguo/dsh-xcode-mcp#readme",
  "bugs": {
    "url": "https://github.com/yankeguo/dsh-xcode-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0",
    "node": ">=24.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:packages": "node scripts/check-packages.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build",
    "release:dry": "pnpm build && node scripts/stage-release.mjs --dry-run",
    "release:stage": "pnpm build && node scripts/stage-release.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <3.20.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
